{
  "name": "leanapp-workspace",
  "description": "LeanApp monorepo: domain-first full-stack applications, LeanReact and the LeanJS compiler",
  "version": "0.2.0-rc.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:blog": "node scripts/build-blog.mjs",
    "screenshots": "npm run build && node scripts/screenshots.mjs",
    "build:engine": "lake build",
    "test": "node scripts/test.mjs",
    "test:docs": "node scripts/check-docs.mjs",
    "test:security": "node scripts/check-security.mjs",
    "build:notes": "node scripts/build-notes.mjs",
    "package:notes": "node scripts/package-notes.mjs",
    "dev:notes": "LEANAPP_DEVELOPMENT=1 node scripts/serve-notes.mjs",
    "start:notes": "node scripts/serve-notes.mjs",
    "test:notes:http": "node --test tests/security/http.test.mjs",
    "test:notes:browser": "node scripts/check-notes-browser.mjs",
    "test:notes:hosted": "node scripts/check-notes-hosted.mjs",
    "test:compiler": "lake env lean --run tests/Run.lean compiler",
    "test:compiler:integration": "lake env lean --run tests/Run.lean integration",
    "test:runtime": "node --test tests/runtime/*.test.mjs",
    "test:browser": "npm run build && playwright test",
    "test:native": "bash tests/native/check.sh",
    "test:native:http": "bash tests/native/run-http.sh",
    "test:native:browser": "npm run build && playwright test --config=playwright.native.config.mjs",
    "test:gateway": "node --test tests/gateway/*.test.mjs",
    "test:framework": "node scripts/check-framework.mjs portable",
    "test:framework:native": "node scripts/check-framework.mjs native",
    "test:framework:browser": "node scripts/check-framework.mjs browser",
    "test:auth": "node scripts/check-framework.mjs auth",
    "test:auth:browser": "playwright test --config=playwright.auth.config.mjs",
    "dev:auth": "node scripts/auth-dev.mjs",
    "build:cafe": "node scripts/build-cafe.mjs",
    "start:cafe": "node scripts/serve-cafe.mjs",
    "dev:cafe": "LEANAPP_DEVELOPMENT=1 node scripts/serve-cafe.mjs",
    "test:cafe": "node --test tests/cafe/*.test.mjs",
    "test:cafe:browser": "playwright test --config=playwright.cafe.config.mjs",
    "package:cafe": "node scripts/package-cafe.mjs",
    "example:consumer": "node examples/consumer/main.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "dev": "node scripts/dev.mjs --watch"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "esbuild": "0.28.2",
    "jsdom": "29.1.1",
    "typescript": "7.0.2"
  }
}
