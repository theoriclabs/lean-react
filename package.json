{
  "name": "leanreact",
  "description": "LeanReact UI libraries and the LeanJS compiler",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:blog": "node scripts/build-blog.mjs",
    "screenshots": "npm run build && node scripts/screenshots.mjs",
    "build:engine": "lake build",
    "test": "node scripts/test.mjs",
    "test:docs": "node scripts/check-docs.mjs",
    "test:manifest": "node scripts/check-manifests.mjs",
    "test:compiler": "lake env lean --run tests/Run.lean compiler",
    "test:compiler:integration": "lake env lean --run tests/Run.lean integration",
    "test:runtime": "node --test tests/runtime/*.test.mjs",
    "test:browser": "npm run build && playwright test",
    "example:consumer": "node examples/consumer/main.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "dev": "node scripts/dev.mjs --watch",
    "test:boundaries": "node scripts/check-boundaries.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "esbuild": "0.28.2",
    "jsdom": "29.1.1",
    "typescript": "7.0.2"
  },
  "imports": {
    "#leancontract/*": "./.lake/packages/leanapi/LeanContract/*"
  }
}
